{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": "src"
  },
  "include": ["src/domain/**/*.ts", "src/data/**/*.ts", "src/services/**/*.ts", "src/state/cart-store.ts"]
}
